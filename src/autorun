#!/usr/bin/env bash
# HAOS Installer — runs automatically when SystemRescue boots from this stick.
#
# Currently: preflight only. It refuses to go further when the machine or the
# medium cannot produce a working install, and reports what it found. Target
# selection and the write itself come next.
#
# Note on how this executes: SystemRescue does not run this file in place. It
# copies it to /var/autorun/tmp/ and runs it there at mode 755, then deletes
# it. The boot filesystem's permission model is therefore irrelevant — a fact
# established by booting real hardware, not assumed.
#
# Deliberately not `set -e`: every failure here is handled explicitly by a
# guard that explains itself. An unexplained exit is worse than none.
set -uo pipefail

BOOTMNT="/run/archiso/bootmnt"
EFI_SYSFS="/sys/firmware/efi"
SOURCE_ONLY=0

# These overrides exist so the logic can be exercised without booting a
# machine. Nothing in normal operation passes them — SystemRescue invokes this
# script with no arguments at all.
while [ $# -gt 0 ]; do
  case "$1" in
    --bootmnt)     BOOTMNT="${2:-}";   shift 2 ;;
    --efi-path)    EFI_SYSFS="${2:-}"; shift 2 ;;
    --source-only) SOURCE_ONLY=1;      shift ;;
    *) shift ;;
  esac
done

hr()  { printf '========================================================\n'; }
say() { printf '%s\n' "$*"; }

# Every refusal states the cause AND the operator's next action. A message
# that only names the failure leaves someone stranded in a live environment
# with no package manager and no browser.
die() {
  printf '\n[FATAL] %s\n\n' "$*" >&2
  exit 1
}

IMAGE=""

# --- preflight guards, in dependency order --------------------------------

require_bootmnt() {
  [ -d "${BOOTMNT}" ] || die "no boot medium found at ${BOOTMNT}.
     This installer is meant to run from the SystemRescue stick, where that
     path is the stick itself. Boot the target machine from the stick and let
     it start on its own — do not run this script on a working system."
}

require_uefi() {
  [ -d "${EFI_SYSFS}" ] || die "this machine booted in legacy BIOS/CSM mode.
     Home Assistant OS requires UEFI. Installing now would write an image this
     machine cannot boot, and the failure would only appear after the disk had
     already been erased.
     Reboot into firmware setup, enable UEFI boot, disable Secure Boot, then
     boot from this stick again."
}

require_single_image() {
  local images=()
  mapfile -t images < <(find "${BOOTMNT}/haos" -maxdepth 1 -type f -name '*.img.xz' 2>/dev/null | sort)

  case "${#images[@]}" in
    0) die "no Home Assistant OS image on this stick (looked in ${BOOTMNT}/haos).
     The stick was not fully populated. On the machine that built it, run:
       ./build/fetch-artifacts.sh
       ./build/make-stick.sh /media/\$USER/RESCUE1302" ;;
    1) IMAGE="${images[0]}" ;;
    *) die "found ${#images[@]} images in ${BOOTMNT}/haos; there must be exactly one.
     This installer will not guess which version you meant. Remove all but the
     one you want to install:
$(printf '       %s\n' "${images[@]}")" ;;
  esac
}

require_checksum() {
  local sidecar="${IMAGE}.sha256" expected actual

  [ -s "${sidecar}" ] || die "no checksum beside $(basename "${IMAGE}").
     Without it there is no way to tell a good image from a damaged one, and
     a damaged image produces a machine that will not boot. Re-populate the
     stick with ./build/make-stick.sh to restore it."

  say "  Verifying image integrity (this reads the whole file)..."
  expected="$(awk '{print $1}' "${sidecar}")"
  actual="$(sha256sum "${IMAGE}" | awk '{print $1}')"

  [ "${expected}" = "${actual}" ] || die "image checksum does not match.
     $(basename "${IMAGE}") is corrupt, or the stick has rotted — flash left in
     a drawer does decay. Nothing has been written to any disk.
     Re-populate the stick with ./build/make-stick.sh and try again.
       expected ${expected}
       actual   ${actual}"
}

# --- candidate enumeration ------------------------------------------------

# Device inventory comes from lsblk's --pairs format, not its columnar output.
# MODEL contains spaces ("EXAMPLE SATA SSD 960G") and TRAN is empty for loop
# and virtio devices, so positional parsing misreads real machines — quietly,
# which is the dangerous kind.
block_devices() {
  lsblk -dPpo NAME,SIZE,TYPE,TRAN,RM,MODEL 2>/dev/null
}

# The medium we booted from is never a candidate. Resolve it from the mount
# through its partition to the parent disk; an unresolvable answer yields an
# empty string, which excludes nothing rather than excluding the wrong thing.
boot_disk() {
  local src parent
  src="$(findmnt -no SOURCE "${BOOTMNT}" 2>/dev/null)" || return 0
  [ -n "${src}" ] || return 0
  parent="$(lsblk -no PKNAME "${src}" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "${parent}" ]; then printf '/dev/%s\n' "${parent}"; else printf '%s\n' "${src}"; fi
}

# filter_candidates <boot-disk> — reads lsblk pairs on stdin, writes the
# device path of every disk we are willing to offer as a target.
#
# Exclusions, each for its own reason:
#   TYPE != disk   partitions, optical drives, loop devices
#   RM = 1         removable media — the operator's other sticks
#   TRAN = usb     the installer's own medium and its neighbours
#   zram/loop/sr   RAM and pseudo devices that report TYPE=disk anyway
#   the boot disk  writing to it mid-run destroys the running system
#
# Undersized disks are NOT excluded. A 16 GB eMMC is a poor host for HAOS, but
# hiding the only disk in the machine is worse than warning about it.
filter_candidates() {
  awk -v boot="${1:-}" '
    function val(line, key,   s) {
      if (match(line, key "=\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(key "=\"", "", s); sub("\"$", "", s)
        return s
      }
      return ""
    }
    {
      name = val($0, "NAME"); type = val($0, "TYPE")
      tran = val($0, "TRAN"); rm   = val($0, "RM")
      if (type != "disk") next
      if (rm == "1") next
      if (tran == "usb") next
      if (name ~ /\/(loop|zram|sr|ram)[0-9]+$/) next
      if (boot != "" && name == boot) next
      print name
    }'
}

# describe_device <path> — reads lsblk pairs on stdin, writes a human summary
describe_device() {
  awk -v want="$1" '
    function val(line, key,   s) {
      if (match(line, key "=\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(key "=\"", "", s); sub("\"$", "", s)
        return s
      }
      return ""
    }
    val($0, "NAME") == want {
      size = val($0, "SIZE"); model = val($0, "MODEL"); tran = val($0, "TRAN")
      if (model == "") model = "(no model reported)"
      if (tran == "") tran = "unknown bus"
      printf "%s  %s  [%s]\n", size, model, tran
    }'
}

list_candidates() {
  block_devices | filter_candidates "$(boot_disk)"
}

# --- report ---------------------------------------------------------------

gather() {
  if [ -d "${EFI_SYSFS}" ]; then firmware="UEFI"; else firmware="legacy BIOS / CSM"; fi

  self="${BASH_SOURCE[0]}"
  mode="$(stat -c '%A (%a)' "${self}" 2>/dev/null)" || mode="unknown"
  if [ -x "${self}" ]; then exec_bit="present"; else exec_bit="ABSENT"; fi

  mount_line="$(awk -v m="${BOOTMNT}" '$2 == m { print $3, $4 }' /proc/mounts 2>/dev/null)"
  [ -n "${mount_line}" ] || mount_line="(not a mount point)"

  # The boot medium is mounted read-only by default — confirmed on hardware.
  # Logging back to the stick needs an explicit remount, which is the writing
  # task's problem, not preflight's.
  probe="${BOOTMNT}/.write-probe.$$"
  if ( : > "${probe}" ) 2>/dev/null; then
    writable="yes"
    rm -f "${probe}"
  else
    writable="no — read-only mount; logging will need remount,rw"
  fi
}

report() {
  hr
  say "  HAOS Installer — preflight passed"
  hr
  say ""
  say "  Firmware mode : ${firmware}"
  say "  Script path   : ${self}"
  say "  Permission    : mode: ${mode} — exec bit ${exec_bit}"
  say "  Boot medium   : ${BOOTMNT}"
  say "  Mounted as    : ${mount_line}"
  say "  Writable      : ${writable}"
  say "  Image         : $(basename "${IMAGE}") (checksum verified)"
  say "  Host          : $(uname -n) / $(uname -r)"
  say "  Date          : $(date -u '+%Y-%m-%d %H:%M:%SZ')"
  say ""
  say "  Payload:"
  find "${BOOTMNT}/haos" -maxdepth 1 -mindepth 1 -printf '    %M %10s  %f\n' 2>&1 | sort -k3
  say ""
  hr
}

# --- persistence ----------------------------------------------------------

# The boot medium mounts read-only, so the run has to remount it to leave any
# trace. Verified working on hardware. This runs whether the installer
# succeeded or refused — a refusal that vanishes at poweroff is the worst
# outcome, because the operator loses the one thing that explains it.
persist_log() {
  local src="$1" rc="$2" logdir="${BOOTMNT}/logs" dest remounted=0

  # Never fabricate the boot medium. If it is not there, there is nothing to
  # write to, and creating directories would only disguise that.
  [ -d "${BOOTMNT}" ] || return 0

  if ! ( : > "${BOOTMNT}/.write-probe.$$" ) 2>/dev/null; then
    if mount -o remount,rw "${BOOTMNT}" 2>/dev/null; then
      remounted=1
    fi
  else
    rm -f "${BOOTMNT}/.write-probe.$$"
  fi

  # Clock skew is real — the test laptop's was three weeks slow — so the name
  # carries the host and the pid too, and successive runs never collide.
  dest="${logdir}/preflight-$(date -u '+%Y%m%dT%H%M%SZ')-$(uname -n)-$$.log"

  if mkdir -p "${logdir}" 2>/dev/null && cp "${src}" "${dest}" 2>/dev/null; then
    sync
    printf '\n  Log written: %s\n' "${dest}"
  else
    printf '\n  Could not write a log to %s — capture the screen instead.\n' "${logdir}"
  fi

  # Leave the medium as it was found, so it can be pulled without a dirty
  # unmount.
  [ "${remounted}" -eq 1 ] && mount -o remount,ro "${BOOTMNT}" 2>/dev/null
  return "${rc}"
}

# --- main -----------------------------------------------------------------

main() {
  require_bootmnt
  require_uefi
  require_single_image
  require_checksum

  gather
  report

  local inventory candidates
  inventory="$(block_devices)"
  candidates="$(printf '%s\n' "${inventory}" | filter_candidates "$(boot_disk)")"

  say "  Installable disks found:"
  if [ -z "${candidates}" ]; then
    say "    (none)"
  else
    while IFS= read -r dev; do
      [ -n "${dev}" ] || continue
      say "    ${dev}  $(printf '%s\n' "${inventory}" | describe_device "${dev}")"
    done <<< "${candidates}"
  fi
  say ""

  say "  Preflight complete. No disk has been touched."
}

# Sourced by the test suite to reach the functions above without running the
# installer. Nothing in normal operation passes this.
[ "${SOURCE_ONLY}" -eq 1 ] && return 0 2>/dev/null

# Capture everything the run says, then persist it. PIPESTATUS carries main's
# own exit status past tee, so the guards' refusals still set the exit code
# SystemRescue sees.
RUNLOG="$(mktemp -t haos-installer.XXXXXX)"
main 2>&1 | tee "${RUNLOG}"
rc="${PIPESTATUS[0]}"

persist_log "${RUNLOG}" "${rc}"
rm -f "${RUNLOG}"
exit "${rc}"
