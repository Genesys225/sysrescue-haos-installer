#!/usr/bin/env bash
# HAOS Installer — runs automatically when SystemRescue boots from this stick.
#
# Currently: preflight only. It refuses to go further when the machine or the
# medium cannot produce a working install, and reports what it found. Target
# selection and the write itself come next.
#
# Note on how this executes: SystemRescue does not run this file in place. It
# copies it to /var/autorun/tmp/ and runs it there at mode 755, then deletes
# it. The boot filesystem's permission model is therefore irrelevant — a fact
# established by booting real hardware, not assumed.
#
# Deliberately not `set -e`: every failure here is handled explicitly by a
# guard that explains itself. An unexplained exit is worse than none.
set -uo pipefail

BOOTMNT="/run/archiso/bootmnt"
EFI_SYSFS="/sys/firmware/efi"
SOURCE_ONLY=0

# These overrides exist so the logic can be exercised without booting a
# machine. Nothing in normal operation passes them — SystemRescue invokes this
# script with no arguments at all.
while [ $# -gt 0 ]; do
  case "$1" in
    --bootmnt)     BOOTMNT="${2:-}";   shift 2 ;;
    --efi-path)    EFI_SYSFS="${2:-}"; shift 2 ;;
    --source-only) SOURCE_ONLY=1;      shift ;;
    *) shift ;;
  esac
done

hr()  { printf '========================================================\n'; }
say() { printf '%s\n' "$*"; }

# Every refusal states the cause AND the operator's next action. A message
# that only names the failure leaves someone stranded in a live environment
# with no package manager and no browser.
die() {
  printf '\n[FATAL] %s\n\n' "$*" >&2
  exit 1
}

IMAGE=""
TARGET=""

# --- preflight guards, in dependency order --------------------------------

require_bootmnt() {
  [ -d "${BOOTMNT}" ] || die "no boot medium found at ${BOOTMNT}.
     This installer is meant to run from the SystemRescue stick, where that
     path is the stick itself. Boot the target machine from the stick and let
     it start on its own — do not run this script on a working system."
}

require_uefi() {
  [ -d "${EFI_SYSFS}" ] || die "this machine booted in legacy BIOS/CSM mode.
     Home Assistant OS requires UEFI. Installing now would write an image this
     machine cannot boot, and the failure would only appear after the disk had
     already been erased.
     Reboot into firmware setup, enable UEFI boot, disable Secure Boot, then
     boot from this stick again."
}

require_single_image() {
  local images=()
  mapfile -t images < <(find "${BOOTMNT}/haos" -maxdepth 1 -type f -name '*.img.xz' 2>/dev/null | sort)

  case "${#images[@]}" in
    0) die "no Home Assistant OS image on this stick (looked in ${BOOTMNT}/haos).
     The stick was not fully populated. On the machine that built it, run:
       ./build/fetch-artifacts.sh
       ./build/make-stick.sh /media/\$USER/RESCUE1302" ;;
    1) IMAGE="${images[0]}" ;;
    *) die "found ${#images[@]} images in ${BOOTMNT}/haos; there must be exactly one.
     This installer will not guess which version you meant. Remove all but the
     one you want to install:
$(printf '       %s\n' "${images[@]}")" ;;
  esac
}

require_checksum() {
  local sidecar="${IMAGE}.sha256" expected actual

  [ -s "${sidecar}" ] || die "no checksum beside $(basename "${IMAGE}").
     Without it there is no way to tell a good image from a damaged one, and
     a damaged image produces a machine that will not boot. Re-populate the
     stick with ./build/make-stick.sh to restore it."

  say "  Verifying image integrity (this reads the whole file)..."
  expected="$(awk '{print $1}' "${sidecar}")"
  actual="$(sha256sum "${IMAGE}" | awk '{print $1}')"

  [ "${expected}" = "${actual}" ] || die "image checksum does not match.
     $(basename "${IMAGE}") is corrupt, or the stick has rotted — flash left in
     a drawer does decay. Nothing has been written to any disk.
     Re-populate the stick with ./build/make-stick.sh and try again.
       expected ${expected}
       actual   ${actual}"
}

# --- candidate enumeration ------------------------------------------------

# Device inventory comes from lsblk's --pairs format, not its columnar output.
# MODEL contains spaces ("EXAMPLE SATA SSD 960G") and TRAN is empty for loop
# and virtio devices, so positional parsing misreads real machines — quietly,
# which is the dangerous kind.
block_devices() {
  lsblk -dPpo NAME,SIZE,TYPE,TRAN,RM,MODEL 2>/dev/null
}

# The medium we booted from is never a candidate. Resolve it from the mount
# through its partition to the parent disk; an unresolvable answer yields an
# empty string, which excludes nothing rather than excluding the wrong thing.
boot_disk() {
  local src parent
  src="$(findmnt -no SOURCE "${BOOTMNT}" 2>/dev/null)" || return 0
  [ -n "${src}" ] || return 0
  parent="$(lsblk -no PKNAME "${src}" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "${parent}" ]; then printf '/dev/%s\n' "${parent}"; else printf '%s\n' "${src}"; fi
}

# filter_candidates <boot-disk> — reads lsblk pairs on stdin, writes the
# device path of every disk we are willing to offer as a target.
#
# Exclusions, each for its own reason:
#   TYPE != disk   partitions, optical drives, loop devices
#   RM = 1         removable media — the operator's other sticks
#   TRAN = usb     the installer's own medium and its neighbours
#   zram/loop/sr   RAM and pseudo devices that report TYPE=disk anyway
#   the boot disk  writing to it mid-run destroys the running system
#
# Undersized disks are NOT excluded. A 16 GB eMMC is a poor host for HAOS, but
# hiding the only disk in the machine is worse than warning about it.
filter_candidates() {
  awk -v boot="${1:-}" '
    function val(line, key,   s) {
      if (match(line, key "=\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(key "=\"", "", s); sub("\"$", "", s)
        return s
      }
      return ""
    }
    {
      name = val($0, "NAME"); type = val($0, "TYPE")
      tran = val($0, "TRAN"); rm   = val($0, "RM")
      if (type != "disk") next
      if (rm == "1") next
      if (tran == "usb") next
      if (name ~ /\/(loop|zram|sr|ram)[0-9]+$/) next
      if (boot != "" && name == boot) next
      print name
    }'
}

# describe_device <path> — reads lsblk pairs on stdin, writes a human summary
describe_device() {
  awk -v want="$1" '
    function val(line, key,   s) {
      if (match(line, key "=\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(key "=\"", "", s); sub("\"$", "", s)
        return s
      }
      return ""
    }
    val($0, "NAME") == want {
      size = val($0, "SIZE"); model = val($0, "MODEL"); tran = val($0, "TRAN")
      if (model == "") model = "(no model reported)"
      if (tran == "") tran = "unknown bus"
      printf "%s  %s  [%s]\n", size, model, tran
    }'
}

list_candidates() {
  block_devices | filter_candidates "$(boot_disk)"
}

# --- target selection -----------------------------------------------------

# What is already on a disk, so the operator can recognise it. Someone who
# cannot tell which disk is which from a model number usually can from
# "500G, NTFS, labelled Windows".
partition_table() {
  lsblk -no NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$1" 2>/dev/null | sed 's/^/      /'
}

# The operator types the device path back. A y/n prompt is answered by reflex;
# a path has to be read first. That difference is the entire safety margin
# between installing and destroying the wrong machine.
confirm_target() {
  local dev="$1" answer
  say ""
  say "  About to ERASE ${dev}"
  say "  Everything on it is destroyed, including any operating system already"
  say "  installed. This cannot be undone."
  say ""
  printf '  Type the device path exactly to confirm: '
  read -r answer || answer=""

  [ "${answer}" = "${dev}" ] ||
    die "confirmation did not match — you typed '${answer}', the target is '${dev}'.
     Nothing was written. No disk has been modified."
}

# Last line of defence. Enumeration only ever offers block devices, so if a
# non-device reaches here something upstream is broken — and the correct
# response to a broken disk-selector is to stop, not to write somewhere else.
require_block_device() {
  [ -b "$1" ] || die "refusing to write to '$1': not a block device.
     The disk list is built from the kernel's own block-device inventory, so
     reaching this point means something upstream is wrong. Nothing has been
     written. Report this rather than working around it."
}

# The uncompressed length, needed to bound verification. Without it the
# comparison would run past the end of the image and into whatever the disk
# held before — reporting a mismatch on a perfectly good write.
image_uncompressed_bytes() {
  xz --robot --list "$1" 2>/dev/null | awk '$1 == "file" { print $5 }'
}

# Streamed, never staged. The decompressed image is around 1.8 GiB and there
# is nowhere sensible to put it: the boot medium is read-only and RAM is the
# live system's.
write_image() {
  local dev="$1"
  say ""
  say "  Writing ${IMAGE##*/} to ${dev}"
  say "  This takes a few minutes. Do not power off or remove the stick."
  say ""

  # iflag=fullblock is not optional here. A pipe hands dd whatever the
  # decompressor produced — often 8 KiB — and without it dd writes that short
  # block and moves on, so bs=4M becomes a fiction: 210,000 partial writes
  # instead of 468 full ones. O_DIRECT then fails on real hardware, because it
  # requires aligned transfers.
  if ! xzcat "${IMAGE}" | dd of="${dev}" bs=4M iflag=fullblock conv=fsync oflag=direct status=progress; then
    # Some devices and filesystems reject O_DIRECT regardless. Falling back is
    # correct, but it goes through the page cache, so the sync below matters.
    say ""
    say "  Direct I/O was refused by ${dev}; retrying through the page cache."
    xzcat "${IMAGE}" | dd of="${dev}" bs=4M iflag=fullblock conv=fsync status=progress ||
      die "the write to ${dev} failed partway through.
     That disk now holds a partial image and must not be booted. Check the
     stick and the target disk, then run the installer again."
  fi

  sync
  say ""
  say "  Write complete."
}

# Read it back and compare. A write that reports success and produces an
# unbootable disk is the failure this exists to catch — cheap insurance
# against a dying stick or a flaky USB bus.
verify_image() {
  local dev="$1" bytes
  bytes="$(image_uncompressed_bytes "${IMAGE}")"
  { [ -n "${bytes}" ] && [ "${bytes}" -gt 0 ]; } 2>/dev/null ||
    die "could not determine the image's uncompressed size, so the write
     cannot be verified. Treat ${dev} as unproven."

  say ""
  say "  Verifying ${bytes} bytes against the image..."

  if xzcat "${IMAGE}" | cmp -n "${bytes}" - "${dev}"; then
    say "  Verification passed — ${dev} matches the image exactly."
  else
    die "VERIFICATION MISMATCH — ${dev} does not match the image.
     Do not boot this machine from that disk. The most likely causes are a
     failing stick or a failing target disk. Run the installer again; if it
     mismatches twice, replace the hardware rather than retrying."
  fi
}

run_selection() {
  local inventory count choice dev i=1
  local candidates=()

  inventory="$(block_devices)"
  # Drop blank lines rather than trusting the producer. An empty string in
  # this array would render as a menu entry with no device, and confirming it
  # would match — a path to running the write against nothing, or worse.
  mapfile -t candidates < <(list_candidates | grep -v '^[[:space:]]*$')
  count="${#candidates[@]}"

  if [ "${count}" -eq 0 ]; then
    die "no installable disk found on this machine.
     Every block device here is removable, USB, or the medium this installer
     booted from — none of them is a safe place for an internal install.
     Check that the target drive is connected and visible in firmware setup."
  fi

  say ""
  say "  Select the disk to install Home Assistant OS onto:"
  say ""
  for dev in "${candidates[@]}"; do
    say "   ${i}) ${dev}  $(printf '%s\n' "${inventory}" | describe_device "${dev}")"
    partition_table "${dev}"
    say ""
    i=$((i + 1))
  done

  # Never auto-select, not even the single-candidate case. A tool that decides
  # for you is one misplaced stick away from erasing the wrong machine.
  printf '  Enter a number (1-%d): ' "${count}"
  read -r choice || choice=""

  case "${choice}" in
    ''|*[!0-9]*) die "'${choice}' is not a number. Nothing was written." ;;
  esac
  { [ "${choice}" -ge 1 ] && [ "${choice}" -le "${count}" ]; } ||
    die "'${choice}' is not one of the offered disks (1-${count}). Nothing was written."

  TARGET="${candidates[$((choice - 1))]}"
  confirm_target "${TARGET}"
  require_block_device "${TARGET}"
  write_image "${TARGET}"
  verify_image "${TARGET}"
  settle_target "${TARGET}"
  report_next_steps "${TARGET}"
  offer_reboot
}

# --- report ---------------------------------------------------------------

gather() {
  if [ -d "${EFI_SYSFS}" ]; then firmware="UEFI"; else firmware="legacy BIOS / CSM"; fi

  self="${BASH_SOURCE[0]}"
  mode="$(stat -c '%A (%a)' "${self}" 2>/dev/null)" || mode="unknown"
  if [ -x "${self}" ]; then exec_bit="present"; else exec_bit="ABSENT"; fi

  mount_line="$(awk -v m="${BOOTMNT}" '$2 == m { print $3, $4 }' /proc/mounts 2>/dev/null)"
  [ -n "${mount_line}" ] || mount_line="(not a mount point)"

  # The boot medium is mounted read-only by default — confirmed on hardware.
  # Logging back to the stick needs an explicit remount, which is the writing
  # task's problem, not preflight's.
  probe="${BOOTMNT}/.write-probe.$$"
  if ( : > "${probe}" ) 2>/dev/null; then
    writable="yes"
    rm -f "${probe}"
  else
    writable="no — read-only mount; logging will need remount,rw"
  fi
}

report() {
  hr
  say "  HAOS Installer — preflight passed"
  hr
  say ""
  say "  Firmware mode : ${firmware}"
  say "  Script path   : ${self}"
  say "  Permission    : mode: ${mode} — exec bit ${exec_bit}"
  say "  Boot medium   : ${BOOTMNT}"
  say "  Mounted as    : ${mount_line}"
  say "  Writable      : ${writable}"
  say "  Image         : $(basename "${IMAGE}") (checksum verified)"
  say "  Host          : $(uname -n) / $(uname -r)"
  say "  Date          : $(date -u '+%Y-%m-%d %H:%M:%SZ')"
  say ""
  say "  Payload:"
  find "${BOOTMNT}/haos" -maxdepth 1 -mindepth 1 -printf '    %M %10s  %f\n' 2>&1 | sort -k3
  say ""
  hr
}

# --- completion -----------------------------------------------------------

# Make the kernel re-read the partition table, then show the operator what
# the disk now holds. Seeing hassos-boot and hassos-data appear is the
# difference between "the tool said OK" and "the disk changed".
settle_target() {
  local dev="$1"
  sync
  partprobe "${dev}" 2>/dev/null || true
  say ""
  say "  ${dev} now contains:"
  partition_table "${dev}"
}

report_next_steps() {
  local dev="$1"
  say ""
  hr
  say "  Home Assistant OS is installed on ${dev}."
  hr
  say ""
  say "  1. Power off and REMOVE THIS USB STICK. If it is left in, the machine"
  say "     may boot the installer again instead of the system you just wrote."
  say ""
  say "  2. Connect Ethernet before first boot. Home Assistant downloads its"
  say "     core on first start and cannot finish setup without internet."
  say ""
  say "  3. First boot takes several minutes and the screen may sit idle while"
  say "     it downloads. That is expected — do not power it off."
  say ""
  say "  4. Then reach it from another machine at:"
  say "        http://homeassistant.local:8123"
  say ""
}

# Kept as separate functions purely so the test suite can replace them. Inline
# `reboot` would have restarted the workstation the first time the suite ran.
do_reboot()   { reboot; }
do_poweroff() { poweroff; }

# Neither option is the default, and Return alone does nothing. An installer
# that reboots on a stray keystroke can pull a disk out from under someone
# mid-copy.
offer_reboot() {
  local answer
  say "  Reboot now, power off, or leave the machine running?"
  printf '    [r] reboot   [p] power off   [anything else] leave it running: '
  read -r answer || answer=""

  case "${answer}" in
    r|R) say ""; say "  Rebooting. Remove the stick as it goes down."; do_reboot ;;
    p|P) say ""; say "  Powering off. Remove the stick before starting it again."; do_poweroff ;;
    *)   say ""; say "  Left running. Remove the stick before the next boot." ;;
  esac
}

# --- persistence ----------------------------------------------------------

# The boot medium mounts read-only, so the run has to remount it to leave any
# trace. Verified working on hardware. This runs whether the installer
# succeeded or refused — a refusal that vanishes at poweroff is the worst
# outcome, because the operator loses the one thing that explains it.
persist_log() {
  local src="$1" rc="$2" logdir="${BOOTMNT}/logs" dest remounted=0

  # Never fabricate the boot medium. If it is not there, there is nothing to
  # write to, and creating directories would only disguise that.
  [ -d "${BOOTMNT}" ] || return 0

  if ! ( : > "${BOOTMNT}/.write-probe.$$" ) 2>/dev/null; then
    if mount -o remount,rw "${BOOTMNT}" 2>/dev/null; then
      remounted=1
    fi
  else
    rm -f "${BOOTMNT}/.write-probe.$$"
  fi

  # Clock skew is real — the test laptop's was three weeks slow — so the name
  # carries the host and the pid too, and successive runs never collide. The
  # target device is included when one was chosen: it is the part an operator
  # can actually correlate with the machine in front of them.
  local what="preflight"
  [ -n "${TARGET}" ] && what="install-$(basename "${TARGET}")"
  dest="${logdir}/${what}-$(date -u '+%Y%m%dT%H%M%SZ')-$(uname -n)-$$.log"

  if mkdir -p "${logdir}" 2>/dev/null && cp "${src}" "${dest}" 2>/dev/null; then
    sync
    printf '\n  Log written: %s\n' "${dest}"
  else
    printf '\n  Could not write a log to %s — capture the screen instead.\n' "${logdir}"
  fi

  # Leave the medium as it was found, so it can be pulled without a dirty
  # unmount.
  [ "${remounted}" -eq 1 ] && mount -o remount,ro "${BOOTMNT}" 2>/dev/null
  return "${rc}"
}

# --- main -----------------------------------------------------------------

main() {
  require_bootmnt
  require_uefi
  require_single_image
  require_checksum

  gather
  report

  run_selection
}

# Sourced by the test suite to reach the functions above without running the
# installer. Nothing in normal operation passes this.
[ "${SOURCE_ONLY}" -eq 1 ] && return 0 2>/dev/null

# Capture everything the run says, then persist it. PIPESTATUS carries main's
# own exit status past tee, so the guards' refusals still set the exit code
# SystemRescue sees.
RUNLOG="$(mktemp -t haos-installer.XXXXXX)"
main 2>&1 | tee "${RUNLOG}"
rc="${PIPESTATUS[0]}"

persist_log "${RUNLOG}" "${rc}"
rm -f "${RUNLOG}"
exit "${rc}"
